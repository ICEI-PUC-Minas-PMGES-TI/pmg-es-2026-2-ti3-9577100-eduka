@startuml 06-portal-do-aluno
!include _estilo.puml
title Eduka — Casos de Uso: Portal do Aluno (UC13, UC22 a UC26, UC36)

left to right direction

actor "ALUNO" as ALUNO
actor "Gateway de Pagamento\n(Asaas)" as ASAAS <<sistema externo>>

rectangle "Eduka — Portal do aluno" {
  usecase "UC22\nVisualizar Meu Perfil" as UC22
  usecase "UC36\nSolicitar Correção\nde Dados" as UC36
  usecase "UC24\nConsultar Disciplinas\ne Turmas" as UC24 <<parcial>>
  usecase "UC23\nConsultar Boletim\nAcadêmico" as UC23
  usecase "Consultar Faltas\ne Frequência" as UC23F
  usecase "Filtrar por Ano\nLetivo e Bimestre" as UC23B
  usecase "UC25\nConsultar Agenda de\nProvas e Tarefas" as UC25
  usecase "Filtrar por\nBimestre" as UC25B
  usecase "UC13\nConsultar Histórico\nFinanceiro do Aluno" as UC13
  usecase "Ver Comprovante\nde Pagamento" as UC13A
  usecase "UC26\nPagar Cobrança Online" as UC26
  usecase "Pagar com PIX" as UC26P
  usecase "Pagar com Boleto" as UC26B
  usecase "Baixar PDF\ndo Boleto" as UC26D
}

ALUNO --> UC22
ALUNO --> UC24
ALUNO --> UC23
ALUNO --> UC25
ALUNO --> UC13

UC22 <.. UC36 : <<extend>>
UC23 ..> UC23F : <<include>>
UC23 <.. UC23B : <<extend>>
UC25 <.. UC25B : <<extend>>
UC13 <.. UC13A : <<extend>>
UC13 <.. UC26 : <<extend>>
UC26 <|-- UC26P
UC26 <|-- UC26B
UC26B <.. UC26D : <<extend>>
UC26 --> ASAAS

note "O boletim mostra pontos por ano letivo e por bimestre e alerta\nquando as faltas passam de 25%. O Início do aluno está no UC16\n(diagrama 02). UC24 segue parcial: mostrar todas as turmas\ne disciplinas é da Sprint 5 (S5-12)." as N1

@enduml
