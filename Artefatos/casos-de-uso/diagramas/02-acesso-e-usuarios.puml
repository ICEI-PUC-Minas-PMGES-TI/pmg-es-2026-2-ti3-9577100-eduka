@startuml 02-acesso-e-usuarios
!include _estilo.puml
title Eduka — Casos de Uso: Acesso, Usuários e Dashboards (UC03, UC04, UC16, UC37, UC38)

left to right direction

actor "SUPER_ADMIN" as SUPERADMIN
actor "ALUNO" as ALUNO
actor "PROFESSOR" as PROFESSOR
actor "FINANCEIRO" as FINANCEIRO
actor "SECRETARIA" as SECRETARIA
actor "MASTER" as MASTER
actor "Usuário da escola" as ESCOLA
actor "Usuário" as USUARIO
actor "Serviço de E-mail\n(Brevo)" as BREVO <<sistema externo>>

' Hierarquia de atores: os cinco perfis da escola especializam
' "Usuário da escola"; ele e o SUPER_ADMIN especializam "Usuário".
MASTER --|> ESCOLA
SECRETARIA --|> ESCOLA
FINANCEIRO --|> ESCOLA
PROFESSOR --|> ESCOLA
ALUNO --|> ESCOLA
ESCOLA --|> USUARIO
SUPERADMIN --|> USUARIO

rectangle "Eduka — Acesso e dashboards" {
  usecase "UC16\nVisualizar Dashboard" as UC16
  usecase "Início do Aluno" as UC16A
  usecase "Encerrar Sessão" as UC03E
  usecase "UC03\nAutenticar Usuário" as UC03
  usecase "Verificar Código\nEnviado por E-mail" as UC03V
  usecase "Reenviar Código" as UC03R
  usecase "Definir Senha no\nPrimeiro Acesso" as UC03P
  usecase "Recuperar Senha\npor E-mail" as UC03S5
  usecase "Renovar Sessão" as UC03T
  usecase "Avisar Escola\nSuspensa" as UC03S
  usecase "UC38\nAceitar Aviso de\nPrivacidade" as UC38
  usecase "UC04\nGerenciar Usuários\nda Escola" as UC04
  usecase "Editar, Inativar ou\nReativar Usuário" as UC04A
  usecase "Reenviar Acesso" as UC04B
  usecase "UC37\nConsultar Registro\nde Atividades" as UC37
}

USUARIO --> UC03
USUARIO --> UC03E
ESCOLA --> UC16
MASTER --> UC04
MASTER --> UC37

UC03 ..> UC03V : <<include>>
UC03V <.. UC03R : <<extend>>
UC03 <.. UC03P : <<extend>>
UC03 <.. UC03S5 : <<extend>>
UC03 <.. UC03T : <<extend>>
UC03 <.. UC03S : <<extend>>
UC03 <.. UC38 : <<extend>>
UC16 <.. UC16A : <<extend>>
UC04 <.. UC04A : <<extend>>
UC04 <.. UC04B : <<extend>>

UC03V --> BREVO
UC03S5 --> BREVO

note "Sprint 5: recuperar senha por e-mail com código de validade\ncurta (S5-02) e renovar a sessão antes de o acesso expirar (S5-04).\nUC04: o MASTER gerencia SECRETARIA e FINANCEIRO na tela Equipe." as N1

@enduml
