@startuml 06-portal-do-professor
!include _estilo.puml
title Eduka — Casos de Uso: Portal do Professor (UC19 a UC21)

left to right direction

actor "PROFESSOR" as PROFESSOR

rectangle "Eduka — Portal do professor" {
  usecase "UC19\nConsultar Turmas e\nDisciplinas Alocadas" as UC19
  usecase "UC20\nCadastrar Avaliações" as UC20
  usecase "UC21\nLançar Notas dos Alunos" as UC21
  usecase "UC18\nAlocar Professor em\nTurmas e Disciplinas" as UC18
  usecase "UC16\nVisualizar Dashboard" as UC16
  usecase "UC03\nAutenticar Usuário" as UC03
}

PROFESSOR --> UC19
PROFESSOR --> UC20
PROFESSOR --> UC21
PROFESSOR --> UC16
PROFESSOR --> UC03

UC19 ..> UC18 : pré-condição
UC20 ..> UC18 : pré-condição
UC21 ..> UC20 : pré-condição

note bottom of UC19
  O professor vê apenas as turmas e
  disciplinas sob sua responsabilidade,
  alocadas pela SECRETARIA (UC18).
end note

note bottom of UC20
  Provas, trabalhos e tarefas nas
  turmas e disciplinas do professor.
end note

note bottom of UC21
  Somente para alunos matriculados,
  por turma e disciplina.
end note

@enduml
