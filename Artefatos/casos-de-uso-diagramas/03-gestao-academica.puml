@startuml 03-gestao-academica
!include _estilo.puml
title Eduka — Casos de Uso: Gestão Acadêmica (UC05 a UC08, UC18, UC29)

left to right direction

actor "SECRETARIA" as SECRETARIA
actor "MASTER" as MASTER
actor "FINANCEIRO" as FINANCEIRO

rectangle "Eduka — Gestão acadêmica" {
  usecase "UC05\nGerenciar Alunos" as UC05
  usecase "Criar Acesso do Aluno" as UC05C
  usecase "Inativar Aluno" as UC05A
  usecase "UC29\nGerenciar Responsáveis" as UC29
  usecase "Vincular Responsável\nao Aluno" as UC29A
  usecase "UC06\nGerenciar Professores" as UC06
  usecase "Criar Acesso do Professor" as UC06C
  usecase "Inativar Professor" as UC06B
  usecase "UC07\nGerenciar Estrutura Acadêmica" as UC07
  usecase "Gerenciar Períodos Letivos" as UC07P
  usecase "Gerenciar Cursos" as UC07C
  usecase "Gerenciar Disciplinas" as UC07D
  usecase "Gerenciar Turmas" as UC07T
  usecase "Associar Turma a\nCurso e Período Letivo" as UC07A
  usecase "UC18\nAlocar Professor em\nTurmas e Disciplinas" as UC18
  usecase "UC08\nRealizar Matrícula de Aluno" as UC08
  usecase "Atualizar Status da Matrícula" as UC08A
}

SECRETARIA --> UC05
SECRETARIA --> UC06
SECRETARIA --> UC07
SECRETARIA --> UC18
SECRETARIA --> UC08

MASTER --> UC06
MASTER --> UC29
SECRETARIA --> UC29
FINANCEIRO --> UC29
MASTER --> UC07

UC05 ..> UC05C : <<include>>
UC05A ..> UC05 : <<extend>>
UC29A ..> UC29 : <<extend>>
UC29A ..> UC05 : pré-condição
UC06 ..> UC06C : <<include>>
UC06B ..> UC06 : <<extend>>
UC07 ..> UC07P : <<include>>
UC07 ..> UC07C : <<include>>
UC07 ..> UC07D : <<include>>
UC07 ..> UC07T : <<include>>
UC07T ..> UC07A : <<include>>
UC08A ..> UC08 : <<extend>>

UC18 ..> UC06 : pré-condição
UC18 ..> UC07 : pré-condição
UC08 ..> UC05 : pré-condição
UC08 ..> UC07 : pré-condição

note bottom of UC05C
  Gera o usuário com perfil ALUNO e envia a
  senha inicial ou o link de primeiro acesso.
  O vínculo com responsáveis é opcional (UC29).
end note

note bottom of UC06C
  Gera o usuário com perfil PROFESSOR e envia a
  senha inicial ou o link de primeiro acesso.
end note

note bottom of UC08
  Pré-condições: aluno previamente cadastrado (UC05)
  e curso/turma disponíveis (UC07).
  Fluxos alternativos: turma sem vagas;
  aluno já matriculado na turma.
end note

note bottom of UC05
  A inativação preserva o histórico do aluno.
end note

note bottom of UC29
  Responsável legal ou financeiro do aluno.
  CPF único por escola; a exclusão é recusada
  enquanto houver aluno vinculado ou cobrança
  lançada para ele. No vínculo se informa o
  parentesco e se ele é o responsável financeiro.
end note

@enduml
