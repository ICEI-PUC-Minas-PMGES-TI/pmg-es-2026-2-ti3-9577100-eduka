# Todos os valores "changeme" abaixo sao apenas para desenvolvimento local.
# Em producao (SPRING_PROFILES_ACTIVE=prod) nenhuma credencial tem default:
# variavel faltando derruba o backend na subida em vez de subir com senha conhecida.

# Superuser de bootstrap do container Postgres. So o container usa.
POSTGRES_DB=eduka
POSTGRES_USER=eduka
POSTGRES_PASSWORD=Eduka-admin
POSTGRES_PORT=5432

# Role restrito com o qual o backend conecta (criado por Codigo/postgres/init/).
DB_APP_USER=eduka_app
DB_APP_PASSWORD=Eduka-admin

# disable = sem TLS. Em producao, gerar certificado e usar verify-full.
DB_SSLMODE=disable

# Login do pgAdmin (http://localhost:PGADMIN_PORT), so no compose de dev.
# O email precisa ter formato valido e dominio comum: o pgAdmin recusa "admin"
# sem dominio e tambem dominios reservados como .local ou .test.
PGADMIN_EMAIL=admin@eduka.com.br
PGADMIN_PASSWORD=Eduka-admin
PGADMIN_PORT=5050

# Chave simetrica AES-256 (32 bytes) codificada em base64, usada para cifrar
# dados pessoais sigilosos (PESSOA: nome, cpf, data de nascimento, email,
# telefone, endereco) antes de gravar no Postgres. Nunca trafega para o banco.
# Gere uma com: openssl rand -base64 32
PII_ENCRYPTION_KEY=changeme-run-openssl-rand-base64-32

# Chave simetrica (HMAC-SHA256) usada para assinar e verificar os JWTs emitidos
# pelo backend. Minimo de 32 bytes. Gere uma com: openssl rand -base64 48
JWT_SECRET=changeme-jwt-secret-with-at-least-32-bytes

# Duracao dos tokens emitidos no login. Opcionais; os valores abaixo sao os padroes.
#JWT_ACCESS_EXPIRATION_MINUTES=60
#JWT_REFRESH_EXPIRATION_DAYS=30

# Origens autorizadas a chamar a API a partir do browser (CORS), separadas por
# virgula. Dev usa o Vite por padrao; em prod fica vazio (Nginx na mesma origem).
#CORS_ALLOWED_ORIGINS=http://localhost:5173

# Endereco do front, usado nos links dos e-mails (ex.: primeiro acesso).
# Em producao, a URL publica do sistema.
#FRONTEND_URL=http://localhost:5173

# Dias de validade da senha provisoria (CPF) enviada no primeiro acesso.
#SENHA_PROVISORIA_VALIDADE_DIAS=7

# Dados mockados de dev: a escola de demonstracao "Colegio Ipe Amarelo" (50
# alunos, professores, turmas, notas, mensalidades e despesas; logins em
# @mock.eduka.com.br com a senha Eduka-mock123) e as escolas de postgres/mock.
# false = nada disso e semeado. So vale no compose de dev; em producao o banco
# nasce vazio sempre. Desligar nao apaga o que ja foi semeado: para isso,
# "docker compose down -v".
#MOCK_DATA=true

# Primeiro super admin, criado na subida se o login ainda nao existe (qualquer
# perfil). Em producao e o unico jeito de ter o primeiro usuario. Senha com 8+
# caracteres; trocar depois nao e desfeito por um restart.
#SUPER_ADMIN_LOGIN=
#SUPER_ADMIN_SENHA=

# Ambiente de apresentacao (SPRING_PROFILES_ACTIVE=prod,demo): sobe a escola de
# demonstracao, os atalhos de Sandbox e a tela /login/demo, que pede este login
# e senha e entra em qualquer conta de teste com um clique. Todas obrigatorias
# no perfil demo. MOCK_SENHA substitui a senha publica Eduka-mock123.
# Nunca usar o perfil demo na producao de verdade.
#DEMO_ACESSO_LOGIN=
#DEMO_ACESSO_SENHA=
#MOCK_SENHA=

# Verificacao em duas etapas do login: depois da senha, o backend manda um
# codigo de 6 digitos para o e-mail do usuario. false = entra so com a senha
# (necessario para o login de um clique em /login/dev).
#LOGIN_VERIFICACAO_HABILITADA=true
# Minutos de validade de cada codigo.
#LOGIN_CODIGO_VALIDADE_MINUTOS=5
# Escreve o codigo no log do backend (docker compose logs backend). O compose
# de dev ja liga, porque sem BREVO_API_KEY o e-mail nao sai. Nunca em producao.
#LOGIN_CODIGO_NO_LOG=true

# Recuperacao de senha ("Esqueceu sua senha?"): codigo de 6 digitos por e-mail.
# Minutos de validade de cada codigo.
#RECUPERACAO_SENHA_VALIDADE_MINUTOS=15
# Escreve o codigo no log do backend. Sem valor, segue LOGIN_CODIGO_NO_LOG.
#RECUPERACAO_SENHA_CODIGO_NO_LOG=true

# E-mail transacional via Brevo (https://app.brevo.com > SMTP & API > API Keys).
# Vazia = nenhum e-mail sai; o backend so registra no log o que teria enviado.
# O remetente precisa estar verificado no Brevo (Senders & IPs).
BREVO_API_KEY=
#BREVO_REMETENTE_EMAIL=nao-responda@eduka.com.br
#BREVO_REMETENTE_NOME=Eduka

# Gateway de pagamento Asaas, so Sandbox nesta sprint. Passo a passo da conta em
# Artefatos/modulo-financeiro/asaas-sandbox-notas.md.
# Chave da conta-pai no Sandbox (Integracoes > Chaves de API). Vazia = backend
# sobe, mas pagar e ativar recebimentos respondem 503. A chave comeca com "$":
# use aspas simples para o compose nao interpolar.
#ASAAS_API_URL=https://api-sandbox.asaas.com
ASAAS_API_KEY=
# Webhook cadastrado em cada conta filha: URL publica terminando em
# /webhooks/asaas (tunel em dev), token de 32 a 255 caracteres e e-mail para
# avisos de falha. Faltando qualquer um, a conta e criada sem webhook.
ASAAS_WEBHOOK_URL=
ASAAS_WEBHOOK_TOKEN=
ASAAS_WEBHOOK_EMAIL=
# true cadastra na subida o mesmo webhook na conta-pai (faturas da plataforma),
# se ainda nao houver um com essa URL. Ligar so na prod: o Sandbox e
# compartilhado pela equipe e um webhook de tunel temporario morre depois.
#ASAAS_WEBHOOK_CONTA_PAI=false
